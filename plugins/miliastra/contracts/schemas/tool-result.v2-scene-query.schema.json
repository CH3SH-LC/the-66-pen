{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miliastra.local/contracts/schemas/tool-result.v2-scene-query.schema.json",
  "title": "Miliastra business tool result, contractVersion 2 (scene-query profile)",
  "description": "A NEW result LAYOUT (v2, profileId scene-query/tool-surface/v2), published beside the frozen layout v1 rather than replacing it. contractVersion stays \"1\": the G01 tool/state contract itself did not change. Generated by .runtime/cordis-plan-work/W7-QUERY-20261002/checks/build_v2_schema.py from backend/scene_query_contract_adapter.py; do not hand-edit.",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "contractName",
    "contractVersion",
    "profileId",
    "capabilityId",
    "method",
    "operationId",
    "caseId",
    "targetHandle",
    "state",
    "ok",
    "isError",
    "writeExecuted",
    "retryAttempted",
    "objectIds",
    "changed",
    "failedItems",
    "nextAction",
    "nextActionDetail",
    "observationLevel",
    "observation",
    "stages",
    "error",
    "evidenceRef",
    "limits",
    "note",
    "unrecognizedObserverKeys"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1",
      "description": "String, not integer. The G01 tool/state contract version, which this profile does NOT change."
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "method": {
      "type": "string",
      "description": "The raw registered tool name, e.g. mw.scene.observeLevel. Stamped by the transport wiring, not by the query service."
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "description": "Null when the caller supplied none; this surface never mints one."
    },
    "caseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetHandle": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetBinding": {
      "$ref": "#/$defs/targetBinding"
    },
    "state": {
      "enum": [
        "rejected",
        "pending",
        "unknown",
        "failed",
        "completed"
      ]
    },
    "operationState": {
      "enum": [
        "never-claimed",
        "claimed",
        "dispatched",
        "known-complete",
        "known-failed",
        "outcome-unknown"
      ]
    },
    "reconcileState": {
      "enum": [
        "never-claimed",
        "known-success",
        "known-failure",
        "unknown"
      ]
    },
    "outcomeKnown": {
      "type": "boolean"
    },
    "writeExecuted": {
      "const": false,
      "description": "Every capability in this profile is a read."
    },
    "created": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "saved": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deleted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "objectIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "failedItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "stages": {
      "$ref": "#/$defs/stages"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "nextAction": {
      "enum": [
        "none",
        "fix-input",
        "poll-same-operation",
        "reconcile",
        "report-and-repair",
        "await-human"
      ]
    },
    "nextActionDetail": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryAttempted": {
      "const": false
    },
    "replayed": {
      "type": "boolean"
    },
    "ok": {
      "type": "boolean"
    },
    "backendKind": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemaVersion": {
      "type": "integer"
    },
    "contract": {
      "type": "string"
    },
    "contractName": {
      "type": "string"
    },
    "isError": {
      "type": "boolean",
      "description": "Must equal (state !== \"completed\"). Published explicitly so a client cannot disagree with state."
    },
    "evidenceRef": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profileId": {
      "type": "string",
      "const": "scene-query/tool-surface/v2",
      "description": "Which versioned result layout this is. Stamped by the transport wiring; the discriminator a v1-only consumer keys off."
    },
    "observationLevel": {
      "enum": [
        "count-only",
        "projected",
        null
      ]
    },
    "observation": {
      "type": [
        "object",
        "null"
      ]
    },
    "limits": {
      "type": "object"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "unrecognizedObserverKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heldForLaterCalls": {
      "type": "boolean"
    },
    "currentSnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "evictedSnapshotIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectIdsTruncated": {
      "type": "boolean"
    },
    "observationNotHeldReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextStep": {
      "type": [
        "string",
        "null"
      ]
    },
    "page": {
      "type": [
        "object",
        "null"
      ]
    },
    "changedIdsShown": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "changedIdsTruncated": {
      "type": "boolean"
    },
    "snapshotPathWithheld": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "STATE-1: ok is derived from state.",
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      }
    },
    {
      "$comment": "isError is the complement of ok, published rather than derived twice.",
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "isError": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "isError": {
            "const": true
          }
        }
      }
    },
    {
      "$comment": "outcomeKnown is false exactly for pending and unknown.",
      "if": {
        "properties": {
          "state": {
            "enum": [
              "pending",
              "unknown"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "outcomeKnown": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "outcomeKnown": {
            "const": true
          }
        }
      }
    },
    {
      "$comment": "A completed read cannot carry an error or a per-object failure.",
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "nextAction": {
            "const": "none"
          },
          "changed": {
            "maxItems": 0
          },
          "failedItems": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "$comment": "A rejected call proves nothing was written and lists no change.",
      "if": {
        "properties": {
          "state": {
            "const": "rejected"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          },
          "writeExecuted": {
            "const": false
          },
          "changed": {
            "maxItems": 0
          },
          "failedItems": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "$comment": "A failed call names its error.",
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "$comment": "Recovery guidance matches the state.",
      "if": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "nextAction": {
            "const": "reconcile"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "nextAction": {
            "const": "poll-same-operation"
          }
        }
      }
    },
    {
      "$comment": "A null observationLevel and a null observation go together: the layer says which of the two things this result is.",
      "if": {
        "properties": {
          "observationLevel": {
            "type": "null"
          }
        },
        "required": [
          "observationLevel"
        ]
      },
      "then": {
        "properties": {
          "observation": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "observation": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveReadback",
        "saveDiff",
        "reopen",
        "runtime",
        "cleanup"
      ],
      "properties": {
        "liveReadback": {
          "$ref": "#/$defs/stage"
        },
        "saveDiff": {
          "$ref": "#/$defs/stage"
        },
        "reopen": {
          "$ref": "#/$defs/stage"
        },
        "runtime": {
          "$ref": "#/$defs/stage"
        },
        "cleanup": {
          "$ref": "#/$defs/stage"
        }
      },
      "description": "A read resolves liveReadback and reports the other four not-run with a reason."
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceRef"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "pass",
            "fail",
            "blocked",
            "unknown",
            "not-applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRef": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "project-relative references for THIS stage only"
        },
        "evidenceSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "detail": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "$comment": "HONEST-3: a pass needs evidence.",
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidenceRef": {
                "minItems": 1
              }
            }
          }
        },
        {
          "$comment": "HONEST-3: everything that is not a pass needs a reason.",
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "pass"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "result"
      ],
      "properties": {
        "objectId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "type": "string"
        },
        "fields": {
          "type": [
            "object",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levelId"
      ],
      "properties": {
        "levelId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "sessionPid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sessionProcessCreation": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "handleResolvedByDiscovery": {
          "type": "boolean"
        }
      },
      "description": "A read binds to a discovery handle and its session; v1 required a backend profile identity a read does not have."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "disposition"
      ],
      "properties": {
        "code": {
          "enum": [
            "ACCEPTANCE_BLOCK_INVALID",
            "BACKEND_NO_JSON_RECEIPT",
            "CANCELLED_BEFORE_DISPATCH",
            "CAPABILITY_NOT_ENABLED",
            "CLEANUP_BRIDGE_UNAVAILABLE",
            "CLEANUP_IDS_DUPLICATED",
            "CLEANUP_IDS_EMPTY",
            "CLEANUP_IDS_NOT_UINT32",
            "CLEANUP_IDS_OVER_LIMIT",
            "CLEANUP_ID_NOT_OWNED_BY_THIS_RUN",
            "CLEANUP_REQUEST_NOT_A_CREATE",
            "CLEANUP_REQUEST_NOT_COMPLETE",
            "CONTRACT_VERSION_UNSUPPORTED",
            "COUNT_IS_NOT_AN_OBSERVATION",
            "CREATE_EFFECT_NOT_AS_REQUESTED",
            "CURSOR_CONTENT_CHANGED",
            "CURSOR_INVALID",
            "CURSOR_LEVEL_CHANGED",
            "CURSOR_OFFSET_OUT_OF_RANGE",
            "CURSOR_SNAPSHOT_CHANGED",
            "CURSOR_TAMPERED",
            "CURSOR_VERSION_UNSUPPORTED",
            "DETAIL_EXCEEDS_MAX_BYTES",
            "DIFF_NEEDS_TWO_OBSERVATIONS",
            "DIFF_SNAPSHOT_ID_INCOMPLETE",
            "DISCOVERY_INTERPRETER_MISSING",
            "DOCUMENT_COUNTS_INCONSISTENT",
            "DOCUMENT_ENTITY_ID_INVALID",
            "DOCUMENT_ENTITY_SHAPE_UNSUPPORTED",
            "DOCUMENT_LEVEL_OBSERVATION_UNSUPPORTED",
            "DOCUMENT_SHAPE_UNSUPPORTED",
            "DOCUMENT_STATUS_UNKNOWN",
            "DOCUMENT_VERSION_UNSUPPORTED",
            "DUPLICATE_ENTITY_IDENTITY",
            "ELEVATED_HEARTBEAT_ABSENT",
            "ELEVATED_HELPER_BLOCKED",
            "ELEVATED_HELPER_DEADLINE_PASSED",
            "ELEVATED_HELPER_NOT_USABLE",
            "ELEVATED_POINTER_MISSING",
            "ELEVATED_QUEUE_AMBIGUOUS",
            "ELEVATED_QUEUE_NOT_FOUND",
            "ELEVATED_QUEUE_OUTSIDE_PROJECT_OR_MISSING",
            "ENTITIES_TRUNCATED",
            "ENTITY_ID_INVALID",
            "EVIDENCE_INTEGRITY_FAILED",
            "EXECUTION_LAYER_BLOCKED",
            "EXECUTION_LAYER_BUSY",
            "EXECUTION_LAYER_UNAVAILABLE",
            "EXTERNAL_BLOCK_INVALID",
            "EXTERNAL_BLOCK_UNKNOWN_ENTITY",
            "HANDLE_REQUIRED",
            "HELD_SNAPSHOT_LIMIT_INVALID",
            "IDENTITY_INVALID",
            "IDENTITY_OBSERVED_AT_INVALID",
            "IDENTITY_RECEIPT_SHA_INVALID",
            "INCOMPATIBLE_VERSION",
            "INPUT_KIND_UNSUPPORTED",
            "LEGACY_READ_NOT_OK",
            "LEGACY_RESULT_CLAIMS_OBSERVATION",
            "LEGACY_RESULT_INVALID",
            "LEVEL_AT_CAPACITY",
            "LEVEL_HANDLE_INVALID",
            "LEVEL_HANDLE_RECEIPT_CHANGED",
            "LEVEL_HANDLE_UNKNOWN",
            "LEVEL_HANDLE_UNVERIFIED",
            "NATIVE_WRITE_REVIEW_REQUIRED",
            "OBSERVATION_NOT_HELD",
            "OBSERVER_CALL_FAILED",
            "OBSERVER_INTERFACE_VERSION_UNSUPPORTED",
            "OBSERVER_MISSING_METHOD",
            "OBSERVER_REFUSED",
            "OBSERVER_RESULT_CONTRADICTORY",
            "OBSERVER_RESULT_INVALID",
            "OBSERVER_RESULT_UNRECOGNIZED_STATE",
            "OPERATION_ID_INVALID",
            "PAGE_LIMIT_EXCEEDS_MAXIMUM",
            "PAGE_LIMIT_INVALID",
            "PROJECTION_INVALID",
            "READBACK_FAILED",
            "READBACK_NOT_ACCEPTED",
            "READBACK_SNAPSHOT_CHANGED",
            "READBACK_SNAPSHOT_UNREADABLE",
            "READBACK_WRONG_LEVEL",
            "READ_MODE_CONTRADICTS_DOCUMENT",
            "READ_NOT_COMPLETED",
            "REQUEST_ID_CONFLICT",
            "REQUEST_ID_INVALID",
            "REQUEST_INCOMPLETE_CLAIM",
            "REQUEST_OUTCOME_UNKNOWN",
            "SAVE_STATUS_NOT_SUCCESS",
            "SAVE_TOUCHED_PROTECTED_TARGET",
            "SCALE_NOT_POSITIVE",
            "SNAPSHOT_LEVEL_MISMATCH",
            "SNAPSHOT_NOT_HELD",
            "SNAPSHOT_NOT_READABLE",
            "SNAPSHOT_STATUS_NOT_OK",
            "SNAPSHOT_UNTRUSTED",
            "STAGE_PASS_WITHOUT_EVIDENCE",
            "STAGE_STATUS_INVALID",
            "SUBSYSTEM_BLOCK_INVALID",
            "SUBSYSTEM_STATUS_UNKNOWN",
            "TARGET_HANDLE_INVALID",
            "TARGET_HANDLE_RECEIPT_CHANGED",
            "TARGET_HANDLE_UNKNOWN",
            "TARGET_HANDLE_UNVERIFIED",
            "TARGET_STALE_REVISION",
            "TEMPLATE_ID_NOT_AN_INTEGER",
            "TEMPLATE_NOT_SUPPORTED",
            "TOOL_UNAVAILABLE_IN_PROFILE",
            "TRANSFORM_INVALID",
            "UPSTREAM_PENDING",
            "UPSTREAM_RECEIPT_UNREADABLE",
            "WRONG_LEVEL"
          ],
          "description": "Closed set: the frozen v1 codes plus the scene-query/upstream codes this profile declares. Generated from the adapter, not hand-copied."
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "before-dispatch",
            "after-dispatch",
            "input",
            "observer",
            "cursor",
            "projection",
            "detail",
            "diff",
            "layer"
          ]
        },
        "disposition": {
          "enum": [
            "refusal-before-dispatch",
            "version-gate",
            "failure-after-dispatch",
            "unknown-after-dispatch"
          ]
        },
        "detail": {
          "type": [
            "object",
            "null"
          ]
        },
        "executionLayerDetail": {
          "type": [
            "object",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": [
            "object",
            "null"
          ]
        },
        "sideEffect": {
          "enum": [
            "none",
            "possible",
            "observed"
          ]
        }
      }
    }
  }
}
