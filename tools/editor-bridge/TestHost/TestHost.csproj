<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AssemblyName>TestHost</AssemblyName>
    <RootNamespace>Miliastra.EditorBridge.TestHost</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <DebugType>none</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Windows-only process APIs are intentional. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    Deliberately no ProjectReference to Miliastra.EditorBridge: the bridge assembly is loaded at
    runtime from an explicit path, which is the same shape as the real Snoop injection path.
  -->

</Project>
